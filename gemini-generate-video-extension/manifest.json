{
  "manifest_version": 3,
  "name": "AMB Gemini Generate Video",
  "version": "1.3.1",
  "description": "Menghubungkan AMB ke UI Gemini pada profil Chrome ini.",
  "permissions": [
    "storage",
    "tabs",
    "downloads",
    "webRequest"
  ],
  "host_permissions": [
    "https://gemini.google.com/*",
    "https://*.googleusercontent.com/*",
    "https://contribution.usercontent.google.com/*",
    "http://127.0.0.1/*",
    "http://127.0.0.1:8766/*"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/pair*",
        "https://gemini.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' ws://127.0.0.1:8766"
  }
}
